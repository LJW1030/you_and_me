# Render Environment에 각각 입력. 이 파일은 실제 비밀값 없이 보관합니다.
SPRING_PROFILES_ACTIVE=cloud
DB_URL=jdbc:postgresql://YOUR-NEON-DIRECT-HOST/neondb?sslmode=require
DB_USER=YOUR_NEON_USER
DB_PASSWORD=SET_IN_RENDER_ONLY
PUSH_ENABLED=false
# Firebase 설정 후 Secret File 경로를 지정하고 PUSH_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
